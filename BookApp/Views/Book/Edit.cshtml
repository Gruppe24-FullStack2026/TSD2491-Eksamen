@model BookApp.Models.Book

@{
    ViewData["Title"] = "Edit Book";
}

<div class="max-w-xl mx-auto mt-10">
    <h2 class="text-3xl font-bold mb-6">Edit Book</h2>
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-red-500 mb-4"></div>
        <input type="hidden" asp-for="Id" />
        <div class="mb-4">
            <label asp-for="Title" class="block font-semibold mb-1"></label>
            <input asp-for="Title" class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" />
            <span asp-validation-for="Title" class="text-red-500 text-sm"></span>
        </div>
        <div class="mb-4">
            <label asp-for="Isbn" class="block font-semibold mb-1"></label>
            <input asp-for="Isbn" class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" />
            <span asp-validation-for="Isbn" class="text-red-500 text-sm"></span>
        </div>
        <div class="mb-4">
            <label asp-for="PublishedYear" class="block font-semibold mb-1"></label>
            <input asp-for="PublishedYear" class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" />
            <span asp-validation-for="PublishedYear" class="text-red-500 text-sm"></span>
        </div>
        <div class="mb-4">
            <label asp-for="Genre" class="block font-semibold mb-1"></label>
            <input asp-for="Genre" class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" />
            <span asp-validation-for="Genre" class="text-red-500 text-sm"></span>
        </div>
        <div class="mb-4">
            <label asp-for="AuthorId" class="block font-semibold mb-1"></label>
            <select asp-for="AuthorId" asp-items="ViewBag.AuthorId" class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400">
                <option value="">-- Select Author --</option>
            </select>
            <span asp-validation-for="AuthorId" class="text-red-500 text-sm"></span>
        </div>
        <div class="flex space-x-3">
            <button type="submit" class="bg-yellow-400 text-white px-4 py-2 rounded hover:bg-yellow-500">Save</button>
            <a asp-action="Index" class="bg-gray-300 text-gray-800 px-4 py-2 rounded hover:bg-gray-400">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}