@model BookApp.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

<div class="max-w-xl mx-auto mt-10">
    <h2 class="text-3xl font-bold mb-6 text-red-600">Delete Book</h2>
    <p class="mb-4 text-gray-600">Are you sure you want to delete this book?</p>
    <div class="border rounded shadow p-6 space-y-4 mb-6">
        <div>
            <span class="font-semibold">Title:</span>
            <span class="ml-2">@Model.Title</span>
        </div>
        <div>
            <span class="font-semibold">ISBN:</span>
            <span class="ml-2">@Model.Isbn</span>
        </div>
        <div>
            <span class="font-semibold">Published Year:</span>
            <span class="ml-2">@Model.PublishedYear</span>
        </div>
        <div>
            <span class="font-semibold">Genre:</span>
            <span class="ml-2">@Model.Genre</span>
        </div>
        <div>
            <span class="font-semibold">Author:</span>
            <span class="ml-2">@Model.Author?.Name</span>
        </div>
    </div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="flex space-x-3">
            <button type="submit" class="bg-red-500 text-white px-4 py-2 rounded hover:bg-red-600">Delete</button>
            <a asp-action="Index" class="bg-gray-300 text-gray-800 px-4 py-2 rounded hover:bg-gray-400">Cancel</a>
        </div>
    </form>
</div>