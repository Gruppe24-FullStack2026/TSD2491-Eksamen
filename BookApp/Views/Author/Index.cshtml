@model IEnumerable<BookApp.Models.Author>

<div class="max-w-5xl mx-auto mt-10">
    <h2 class="text-3xl font-bold mb-6">Authors</h2>
    <a asp-action="Create"
       class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 mb-6 inline-block">
        Add New Author
    </a>

    <table class="w-full border-collapse shadow rounded">
        <thead class="bg-blue-600 text-white">
            <tr>
                <th class="p-3 text-left">Name</th>
                <th class="p-3 text-left">Nationality</th>
                <th class="p-3 text-left">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var author in Model)
            {
                <tr class="border-b hover:bg-gray-50">
                    <td class="p-3">@author.Name</td>
                    <td class="p-3">@author.Nationality</td>
                    <td class="p-3 space-x-2">
                        <a asp-action="Edit" asp-route-id="@author.Id"
                           class="bg-yellow-400 text-white px-3 py-1 rounded hover:bg-yellow-500">
                            Edit
                        </a>
                        <a asp-action="Details" asp-route-id="@author.Id"
                           class="bg-blue-400 text-white px-3 py-1 rounded hover:bg-blue-500">
                            Details
                        </a>
                        <a asp-action="Delete" asp-route-id="@author.Id"
                           class="bg-red-500 text-white px-3 py-1 rounded hover:bg-red-600">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
