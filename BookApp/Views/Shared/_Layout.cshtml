<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BookApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="flex items-center justify-between px-6 py-3 bg-white border-b shadow-sm mb-6">
            <a class="text-xl font-bold text-gray-800" asp-area="" asp-controller="Home" asp-action="Index">BookApp</a>
            <ul class="flex gap-6">
                <li>
                    <a class="text-gray-700 hover:text-blue-600 hover:underline" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                </li>
                <li>
                    <a class="text-gray-700 hover:text-blue-600 hover:underline" asp-area="" asp-controller="Book" asp-action="Index">Books</a>
                </li>
                <li>
                    <a class="text-gray-700 hover:text-blue-600 hover:underline" asp-area="" asp-controller="Author" asp-action="Index">Authors</a>
                </li>
                <li>
                    <a class="text-gray-700 hover:text-blue-600 hover:underline" asp-controller="ApiImport" asp-action="Index">Import Books</a>
                </li>
            </ul>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - BookApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
